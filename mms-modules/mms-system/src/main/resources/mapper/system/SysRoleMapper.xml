<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sxpcwlkj.system.mapper.SysRoleMapper">

    <select id="selectPageList" resultType="com.sxpcwlkj.system.entity.vo.SysRoleVo">
        SELECT *
        FROM `sys_role` ${ew.getCustomSqlSegment}
    </select>

    <select id="selectByUserId" resultType="com.sxpcwlkj.system.entity.vo.SysRoleVo">
        SELECT *
        FROM `sys_user_role` ur
                 LEFT JOIN `sys_role` r ON ur.`role_id` = r.`id`
        WHERE ur.`user_id` = #{userId}
        ORDER BY r.`sort` DESC LIMIT 1
    </select>
    <select id="selectByCode" resultType="com.sxpcwlkj.system.entity.vo.SysRoleVo">
        SELECT *  FROM `sys_role` WHERE `code`=#{roleCode}
    </select>
    <select id="selectByUserIdList" resultType="com.sxpcwlkj.system.entity.vo.SysRoleVo">
        SELECT *
        FROM `sys_user_role` ur
                 LEFT JOIN `sys_role` r ON ur.`role_id` = r.`id`
        WHERE ur.`user_id` = #{userId}
        ORDER BY r.`sort`
    </select>
</mapper>
