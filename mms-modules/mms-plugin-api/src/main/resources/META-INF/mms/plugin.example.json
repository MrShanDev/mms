{
  "id": "com.example.mms.comments",
  "version": "1.0.0",
  "name": "评论插件",
  "description": "示例：本文件仅描述契约；宿主加载逻辑由 mms-plugin-host 实现。",
  "requiresMms": {
    "revisionMin": 21,
    "revisionMax": 21,
    "springBoot": "3.5.8"
  },
  "entryClass": "com.example.mms.comments.CommentsPlugin",
  "kind": "extension",
  "runtimeMode": "SPI_ONLY",
  "hostServicesContractVersion": 1,
  "pluginTablePrefix": "plugin_example_",
  "dependencies": [
    {
      "id": "com.example.mms.user-api",
      "versionRange": "[1.0.0,2.0.0)",
      "optional": false
    }
  ],
  "frontend": {
    "modulePackage": "@example/mms-comments-ui",
    "compatibleMmsUi": "1.x",
    "routePrefixes": ["/comments"]
  }
}
