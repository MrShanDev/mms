# MMS 主工程（Java / Maven）
# 规则适用于本仓库整树；子 module 目录不再单独放置重复的 .gitignore

# ----- 编译与构建 -----
**/target/
*.class
.flattened-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# ----- JVM 崩溃与堆转储 -----
hs_err_pid*
replay_pid*
*.hprof
.attach_pid*

# ----- 日志 -----
*.log

# ----- 本地 SQL 备份（工具生成，勿入库）-----
script/db/.back_sxpcwlkj/
script/db/.version_sxpcwlkj/

# ----- Eclipse / IDEA -----
.classpath
.project
.settings/
.idea/
*.iml
*.iws
*.ipr

# ----- VS Code -----
.vscode/

# ----- 其他 IDE / 旧版 Spring Tool Suite -----
.apt_generated
.factorypath
.springBeans
.sts4-cache
*.suo
*.ntvs*
*.njsproj
*.sln

# ----- Gradle（若个别模块使用）-----
.gradle/
build/

# ----- 操作系统 -----
.DS_Store
Thumbs.db

# ----- 若需在仓库根并排放置 mms-ui 源码时的本地依赖 -----
node_modules/

# ----- 敏感本地环境（勿提交密钥）-----
.env.local
.env.*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
